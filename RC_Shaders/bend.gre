<!-- bending -->
<ShaderEffect name="Bend" menuPath="Transform">
    <Properties>

        <Property
            name="bendAmount"
            nameUI="Bend Amount"
            type="float"
            min="-2.0"
            max="2.0"
            ini="0.0"
            step="0.01"
            glValue="true"/>

        <Property
            name="bendRadius"
            nameUI="Bend Radius"
            type="float"
            min="0.1"
            max="10.0"
            ini="2.0"
            step="0.1"
            glValue="true"/>

        <Property
            name="pivot"
            nameUI="Pivot"
            type="float"
            min="0.0"
            max="1.0"
            ini="0.5"
            step="0.01"
            glValue="true"/>

        <Property
            name="bendVertical"
            nameUI="Direction"
            type="int"
            min="0"
            max="1"
            ini="0"
            step="1"
            glValue="true"/>

        <!-- Margin control -->
        <Property
            name="bendMargin"
            nameUI="Margin"
            type="float"
            min="0.0"
            max="500.0"
            ini="50.0"
            step="1.0"/>

    </Properties>

    <!-- Expands layer bounds to avoid clipping -->
    <Margin value="bendMargin"/>

</ShaderEffect>

