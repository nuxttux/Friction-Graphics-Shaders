<!-- Halftone V2 -->
<ShaderEffect name="Halftone Advanced" menuPath="Stylize">
    <Properties>

        <Property name="dotSize"
                  nameUI="Dot Size (px)"
                  type="float"
                  min="2.0"
                  max="200.0"
                  ini="16.0"
                  step="1.0"
                  glValue="true"/>

        <Property name="contrast"
                  nameUI="Contrast"
                  type="float"
                  min="0.2"
                  max="2.0"
                  ini="1.2"
                  step="0.05"
                  glValue="true"/>

        <Property name="angle"
                  nameUI="Rotation"
                  type="float"
                  min="0.0"
                  max="90.0"
                  ini="15.0"
                  step="1.0"
                  glValue="true"/>

        <Property name="dotOpacity"
                  nameUI="Dot Opacity"
                  type="float"
                  min="0.0"
                  max="1.0"
                  ini="0.75"
                  step="0.05"
                  glValue="true"/>

        <Property name="shapeMode"
                  nameUI="Shape"
                  type="int"
                  min="0"
                  max="2"
                  ini="0"
                  step="1"
                  glValue="true"/>

        <Property name="blendMode"
                  nameUI="Blend Mode"
                  type="int"
                  min="0"
                  max="3"
                  ini="1"
                  step="1"
                  glValue="true"/>

        <Property name="dotColor"
                  nameUI="Dot Color"
                  type="color"
                  ini="[0, 0, 0, 255]"
                  glValue="true"/>

        <Property name="invert"
                  nameUI="Invert"
                  type="float"
                  min="0.0"
                  max="1.0"
                  ini="0.0"
                  step="1.0"
                  glValue="true"/>

    </Properties>
</ShaderEffect>

