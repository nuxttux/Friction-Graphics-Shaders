<!-- Bend V2 -->
<ShaderEffect name="Bend V2" menuPath="Transform">
    <Properties>

        <Property
            name="bendAmount"
            nameUI="Bend Amount"
            type="float"
            min="-2.0"
            max="2.0"
            ini="0.0"
            step="0.01"
            glValue="true"/>

        <Property
            name="bendRadius"
            nameUI="Bend Radius"
            type="float"
            min="0.1"
            max="10.0"
            ini="2.5"
            step="0.1"
            glValue="true"/>

        <Property
            name="pivot"
            nameUI="Pivot"
            type="float"
            min="0.0"
            max="1.0"
            ini="0.5"
            step="0.01"
            glValue="true"/>

        <Property
            name="bendVertical"
            nameUI="Direction"
            type="int"
            min="0"
            max="1"
            ini="0"
            step="1"
            glValue="true"/>

        <!-- Padding to prevent clipping -->
        <Property
            name="bendMargin"
            nameUI="Bounds Padding"
            type="float"
            min="0"
            max="600"
            ini="120"
            step="1"/>

    </Properties>

    <Margin value="bendMargin"/>
</ShaderEffect>

